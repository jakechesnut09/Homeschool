  "weeks": [
    {
      "week": 1,
      "unit": 1,
      "topic": "Kinds of line",
      "objectives": [
        "Use a variety of lines expressively",
        "Describe lines in artworks"
      ],
      "standards": [
        "VA:Cr2.1.3",
        "VA:Re7.1.3"
      ],
      "vocabulary": [
        "line",
        "contour",
        "zigzag",
        "expressive"
      ],
      "materials": [
        "sketchbook",
        "pencils",
        "markers"
      ],
      "days": [
        {
          "title": "Line hunt",
          "work": "Find 10 kinds of lines in your home and draw each in a sketchbook line chart."
        },
        {
          "title": "Line in art",
          "work": "Look at a Van Gogh painting ('The Starry Night') and describe how the lines show movement."
        },
        {
          "title": "Feelings in lines",
          "work": "Draw lines to show calm, angry, excited and sleepy to music."
        },
        {
          "title": "Line design",
          "work": "Create a full-page line design using at least 8 line types."
        },
        {
          "title": "Review & sing",
          "work": "Share the line design and sing a warm-up echo song keeping a steady beat."
        }
      ],
      "assessment": "Line design and description"
    },
    {
